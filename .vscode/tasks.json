                "Bypass",
                "-File",
                "${workspaceFolder}\\.vscode\\scripts\\cmake-msvc.ps1",
                "test",
                "Release"
            ],
            "problemMatcher": [],
            "dependsOn": "CMake Build: Windows MSVC Release"
        }
    ]
}
