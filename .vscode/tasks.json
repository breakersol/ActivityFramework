{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake Configure: Android arm64 Debug",
            "type": "process",
            "command": "cmake",
            "args": [
                "--preset",
                "android-arm64-debug",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "CMake Build: Android arm64 Debug",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "android-arm64-debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "CMake Configure: Android arm64 Debug",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "CMake Configure: Windows MSVC Debug",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\.vscode\\scripts\\cmake-msvc.ps1",
                "configure",
                "Debug"
            ],
            "problemMatcher": []
        },
        {
            "label": "CMake Build: Windows MSVC Debug",
